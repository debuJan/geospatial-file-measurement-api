<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>sample measurements</name>
    <description>Sample KML for the Geospatial File Measurement API: one polygon, one linestring, one point (all EPSG:4326 per the KML spec).</description>
    <Placemark>
      <name>square</name>
      <description>0.01 x 0.01 degree square at the equator</description>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              0,0,0 0.01,0,0 0.01,0.01,0 0,0.01,0 0,0,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>line</name>
      <description>0.01 degree line along the equator</description>
      <LineString>
        <coordinates>0,0,0 0.01,0,0</coordinates>
      </LineString>
    </Placemark>
    <Placemark>
      <name>point</name>
      <description>a point has no measurement</description>
      <Point>
        <coordinates>0.005,0.005,0</coordinates>
      </Point>
    </Placemark>
  </Document>
</kml>
